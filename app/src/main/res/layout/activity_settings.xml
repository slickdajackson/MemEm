<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111113"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/version_title"
            android:textColor="#F5C518"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Private Meme-Tastatur. MemEm sendet nie selbst."
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/enable_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tastatur aktivieren" />

        <Button
            android:id="@+id/enable_a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bedienungshilfe öffnen" />

        <TextView
            android:id="@+id/a11y_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#CCCCCC" />

        <Switch
            android:id="@+id/overlay_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Schwebender Punkt (zweiter Einstieg)"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/overlay_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Über anderen Apps einblenden" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Einfügen"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/insert_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/insert_clipboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zwischenablage, dann Commit-Content"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/insert_commit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Commit-Content, wenn das Feld Bilder annimmt"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/insert_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Automatisch nach MIME-Typ"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gemma-Rechenwerk"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/backend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/backend_cpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CPU (Standard)"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/backend_gpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GPU"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <Button
            android:id="@+id/download"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Modelle laden (Embedding und Gemma CPU)" />

        <Button
            android:id="@+id/download_gpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zusätzlich Gemma GPU laden" />

        <TextView
            android:id="@+id/model_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#CCCCCC" />

        <Button
            android:id="@+id/open_harness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Testfeld fürs Einfügen öffnen" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/hyperos_hint"
            android:textColor="#AAAAAA" />
    </LinearLayout>
</ScrollView>
