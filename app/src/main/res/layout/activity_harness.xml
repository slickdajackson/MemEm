<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111113"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Testfeld"
        android:textColor="#F5C518"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Dieses Feld nimmt image/png per Commit-Content und per Einfügen aus der Zwischenablage an."
        android:textColor="#FFFFFF" />

    <EditText
        android:id="@+id/field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nachricht"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:minHeight="72dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888" />

    <ImageView
        android:id="@+id/received"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Empfangenes Meme"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#CCCCCC" />
</LinearLayout>
