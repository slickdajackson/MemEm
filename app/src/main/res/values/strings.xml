    <string name="keyboard_kicker">KEYBOARD</string>
    <string name="keyboard_title">Turn MemEm on</string>
    <string name="keyboard_body">The button opens Settings, on-screen keyboards. Turn MemEm on. The check appears on its own when you come back.</string>
    <string name="open_ime_settings">Open on-screen keyboards</string>

    <string name="active_kicker">ACTIVE</string>
