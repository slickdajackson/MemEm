    <string name="lang_kicker">LANGUAGE</string>
    <string name="lang_title">English or Deutsch</string>
    <string name="lang_body">This sets the app language and the keyboard. English is QWERTY, space bar EN. Deutsch is QWERTZ, space bar DE, with umlauts on a long press. A short press on the globe switches between the two. A long press still opens the full keyboard list.</string>
    <string name="lang_en">English</string>
    <string name="lang_de">Deutsch</string>

    <string name="welcome_kicker">WELCOME</string>
    <string name="welcome_title">Three memes, no sending</string>
    <string name="welcome_body">MemEm is a keyboard. You type, press Meme, and three pictures appear. One of them lands in the field. Nothing is ever sent.</string>

    <string name="models_kicker">MODELS</string>
    <string name="models_title">Download once, then local</string>
    <string name="models_body">Embedding is about 157 MB. Gemma is about 2.6 GB. Wi-Fi is best. The download keeps going in the background if you leave the app.</string>
