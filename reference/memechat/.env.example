# All optional; defaults in src/memechat/config.py
# LLM: any OpenAI-compatible server (oMLX locally; vLLM/SGLang later). Key defaults to ~/.omlx/settings.json auth.api_key
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3.8-27B-MLX-4bit
# LLM_API_KEY=
EMBED_MODEL=~/.omlx/models/google/embeddinggemma-2
EMBED_DEVICE=mps
QDRANT_URL=http://127.0.0.1:6333
MEMEGEN_URL=http://127.0.0.1:5051
# search fusion weights (0 disables a kind)
W_TEXT=1.0
W_IMAGE=0.5
W_IMAGE_TEXT=1.0
CONTEXT_MESSAGES=8
